      <img class="qr-payment-image" style="width:190px; height:190px; border-radius:10px; display:block; margin:0 auto 8px; background:#fff;" alt="PhonePe QR Code" src="data:image/jpeg;base64," style="display:block;width:100%;height:auto;max-width:100%;object-fit:contain;border-radius:12px;margin:8px auto 0;" alt="BharatPe QR Code">
      <div style="color:#fff; font-size:13px; font-weight:800;">PRAKASH KUMAR</div>
      <div style="color:var(--accent); font-size:11px; font-family:monospace;">BHARATPE2V0Z0B8E6I76659@unitype</div>
    </div>
    

    <div style="background: #0d0f17; padding: 12px; border-radius: 12px; margin-bottom: 14px; border: 1px solid #23283a;">
      <div style="font-size: 11px; color: var(--text-muted);">वर्तमान वॉलेट बैलेंस:</div>
      <div style="font-size: 24px; font-weight: 800; color: var(--success);" id="modalAddBal">₹0.00</div>
    </div>

    <div class="input-group">

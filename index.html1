<style>
/* Four-image tournament row: independent of the original match cards */
.tournament-photo-row{margin:18px 0 22px;padding:0 18px}
.tournament-photo-row h3{font-size:16px;margin:0 0 10px;font-weight:800}
.tournament-photo-scroll{display:flex;gap:12px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;padding:2px 2px 12px;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}
.tournament-photo-scroll::-webkit-scrollbar{height:5px}
.tournament-photo-scroll::-webkit-scrollbar-thumb{background:#ff5e00;border-radius:8px}
.tournament-photo-tile{flex:0 0 78%;max-width:320px;background:#141724;border:1px solid #29324b;border-radius:14px;overflow:hidden;scroll-snap-align:start}
.tournament-photo-tile img{display:block;width:100%;height:155px;object-fit:cover}
.tournament-photo-tile .photo-label{padding:10px;font-size:12px;font-weight:800;color:#fff}
.tournament-photo-hint{font-size:10px;color:#8e95aa;margin-top:3px}
@media(min-width:420px){.tournament-photo-tile{flex-basis:72%}}
</style>

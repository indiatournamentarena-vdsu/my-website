<!-- Added compact My Profile popup; existing modals remain unchanged -->
<div class="zest-profile-overlay" id="zestProfileOverlay" onclick="if(event.target===this) closeZestProfile()">
  <div class="zest-profile-card">
    <button class="zest-profile-back" onclick="closeZestProfile()" aria-label="वापस">← Back</button><div class="zest-profile-head"><b>👤 My Profile</b><button class="zest-profile-close" onclick="closeZestProfile()">✕</button></div>
<div class="zest-profile-body">
      <div class="zest-profile-identity"><div class="zest-profile-avatar" id="zestProfileAvatar">FF</div><div class="zest-profile-name" id="zestProfileName">Player_IGN</div></div>
      <div style="text-align:center;margin:8px 0 4px"><button type="button" onclick="openEditIgnModal()" style="border:1px solid #64748b;border-radius:10px;background:#25334b;color:#fff;padding:8px 15px;font-weight:800">✏️ नाम / UID Edit</button></div>
      <div class="zest-profile-uid">UID: <span id="zestProfileUid">0000000000</span></div>
      <div class="zest-profile-wallet-actions">
        <button class="profile-action-deposit" type="button" onclick="openProfileAction('addMoneyModal')">➕ पैसे डालें</button>
        <button class="profile-action-withdraw" type="button" onclick="openProfileAction('withdrawModal')">💸 Withdraw</button>
        <button class="profile-action-passbook" type="button" onclick="openProfileAction('historyModal')">📒 पासबुक</button>
      </div>
      <div class="zest-profile-grid"><div class="zest-profile-stat"><b>Referral Bonus Points</b><span id="zestReferralPoints">0</span></div>

        <div class="zest-profile-stat"><span>Wallet Balance</span><b id="zestProfileWallet">₹0.00</b></div>
        <div class="zest-profile-stat"><span>आज Join किए मैच (रात 12 बजे Reset)</span><b id="zestProfileJoined">0</b><div class="daily-match-note">पिछले 24 घंटे नहीं—आज की गिनती</div></div>
        <div class="zest-profile-stat"><span>Referral Code</span><b id="zestProfileReferral">—</b></div>
        <div class="zest-profile-stat"><span>Player Status</span><b>Active</b></div>
      </div>
      <div class="zest-profile-extra"><button type="button" id="zestTop50Toggle" onclick="toggleProfileLeaderboard()">🏆 Top 100 मैच ▾</button><button type="button" onclick="openReferralPendingPanel()">🎁 Referral Requests</button></div>
      <button type="button" id="zestRoomAccessBtn" class="zest-admin-room-btn" onclick="openRoomAccessPanel()" style="display:none"><span class="zarb-crown">👑</span><span class="zarb-text"><b>Room Access Log</b><small>किसने Room ID &amp; Password खोला · सिर्फ़ Admin</small></span></button>
      <button type="button" id="zestAdminSettingsBtn" class="zest-admin-settings-btn" onclick="openAdminSecurityPrompt()" style="display:none"><span>👑</span><span><b>Admin Settings</b><small>बैनर · मैच · लॉक · रिज़ल्ट · वॉलेट · सिर्फ़ Admin</small></span></button>
      <div id="zestProfileLeaderboardPanel" aria-hidden="true" style="display:none;margin-top:10px;padding:10px;background:#0c1220;border:1px solid #34415f;border-radius:12px"><div id="zestProfileLeaderboardStatus" style="font-size:11px;color:#aab3c5;text-align:center;padding:6px">Top 100 मैच रैंकिंग लोड हो रही है…</div><div id="zestProfileLeaderboardList" style="display:flex;flex-direction:column;gap:7px;max-height:36vh;overflow:auto"></div><button type="button" onclick="toggleProfileLeaderboard(false)" style="width:100%;margin-top:8px;border:0;border-radius:9px;padding:8px;background:#252d40;color:white;font-weight:700">▲ सूची बंद करें</button></div>
      <button class="btn-submit" style="width:100%;margin-top:12px" onclick="closeZestProfile()">← वापस</button>
    </div>
  </div>
</div>

<!-- ================= 0. STEP-1: LOGOUT WARNING ================= -->
<div class="modal-overlay" id="logoutStep1Modal">
  <div class="modal-box" style="text-align: center;">
    <button class="modal-close" onclick="closeModal('logoutStep1Modal')">✕</button>
    <div style="font-size: 36px; margin-bottom: 8px;">⚠️</div>
    <div class="modal-title" style="color: #ffb703; font-size: 20px;">लॉग आउट चेतावनी!</div>
    <div class="modal-sub" style="font-size: 13px; color: #e2e8f0; line-height: 1.6; margin-bottom: 20px;">
      क्या आप सच में अपनी आईडी को लॉग आउट करना चाहते हैं?
    </div>

    <div style="display: flex; gap: 10px;">
      <button class="action-btn btn-pay" onclick="proceedToGreenLogoutStep2()">
        हाँ, लॉग आउट करना है
      </button>
      <button class="action-btn btn-room" onclick="closeModal('logoutStep1Modal')">
        नहीं, रद्द करें
      </button>
    </div>
  </div>
</div>

<!-- ================= STEP-2: GREEN BUTTON MODAL ================= -->
<div class="modal-overlay" id="logoutStep2Modal">
  <div class="modal-box" style="text-align: center;">
    <button class="modal-close" onclick="closeModal('logoutStep2Modal')">✕</button>
    <div style="font-size: 36px; margin-bottom: 8px;">✅</div>
    <div class="modal-title" style="color: #00e676; font-size: 20px;">आईडी लॉग आउट पुष्टिकरण</div>
    <div class="modal-sub" style="font-size: 13px; color: #cbd5e1; line-height: 1.6; margin-bottom: 20px;">
      लॉग आउट करने और होम स्क्रीन पर जाने के लिए नीचे दिए गए हरे बटन पर क्लिक करें।
    </div>

    <button class="action-btn" style="width: 100%; padding: 14px; background: linear-gradient(135deg, #00c853 0%, #009624 100%); color: #fff; font-size: 15px; font-weight: 800; border-radius: 12px; box-shadow: 0 4px 18px rgba(0, 200, 83, 0.45); cursor: pointer;" onclick="finalLogoutToHomeScreen()">
      🟢 अपना लॉग आउट कर लो
    </button>
    
    <button class="action-btn btn-room" style="width: 100%; margin-top: 10px;" onclick="closeModal('logoutStep2Modal')">
      वापस जाएँ
    </button>
  </div>
</div>

<!-- ================= MODAL: GREEN PARTICIPATION CONFIRMATION (WALLET HAS MONEY) ================= -->
<div class="modal-overlay" id="joinConfirmGreenModal">
  <div class="modal-box" style="text-align: center;">
    <button class="modal-close" onclick="closeModal('joinConfirmGreenModal')">✕</button>
    <div style="font-size: 38px; margin-bottom: 8px;">🎮</div>
    <div class="modal-title" style="color: #00e676; font-size: 20px;" id="greenModalMatchName">टूर्नामेंट जॉइन करें</div>
    <div class="modal-sub" style="font-size: 13px; color: #cbd5e1; line-height: 1.6; margin-bottom: 20px;" id="greenModalSub">
      मैच की सेट की गई एंट्री फीस आपके वॉलेट से काटी जाएगी।
    </div>

    <!-- REQUESTED GREEN BUTTON -->
    <button class="action-btn" id="btnConfirmGreenJoin" style="width: 100%; padding: 14px; background: linear-gradient(135deg, #00c853 0%, #009624 100%); color: #fff; font-size: 15px; font-weight: 800; border-radius: 12px; box-shadow: 0 4px 18px rgba(0, 200, 83, 0.45); cursor: pointer;" onclick="executeWalletDeductionAndUnlock()">
      🟢 हाँ, मैं भाग लेना चाहता हूँ
    </button>
    
    <button class="action-btn btn-room" style="width: 100%; margin-top: 10px;" onclick="closeModal('joinConfirmGreenModal')">
      नहीं, अभी नहीं
    </button>
  </div>
</div>

<!-- ================= MODAL: ROOM LOCKED (WALLET DOES NOT HAVE MONEY -> OPEN PHONEPE) ================= -->
<div class="modal-overlay" id="roomLockedModal">
  <div class="modal-box" style="text-align: center;">
    <button class="modal-close" onclick="closeModal('roomLockedModal')">✕</button>
    <div style="font-size: 38px; margin-bottom: 8px;">🔒</div>
    <div class="modal-title" style="color: #ffb703; font-size: 20px;">रूम आईडी और पासवर्ड लॉक है!</div>
    <div class="modal-sub" style="font-size: 13px; color: #cbd5e1; line-height: 1.6; margin-bottom: 20px;" id="roomLockedSub">
      आपने इस मैच की एंट्री फीस नहीं भरी है और आपके वॉलेट में पर्याप्त बैलेंस नहीं है। टूर्नामेंट में भाग लेने और रूम अनलॉक करने के लिए PhonePe से पेमेंट करें।
    </div>

    <button class="action-btn btn-pay" id="btnPayViaPhonePe" style="width: 100%; padding: 14px; font-size: 15px; font-weight: 800; border-radius: 12px;" onclick="executePhonePePaymentFromModal()">
      ⚡ PhonePe से ₹5 देकर अनलॉक करें
    </button>
    
    <button class="action-btn btn-room" style="width: 100%; margin-top: 10px;" onclick="closeModal('roomLockedModal')">
      बंद करें
    </button>
  </div>
</div>

<!-- ================= 1. SECURE ROOM ID MODAL (STRICTLY FOR CONFIRMED PLAYERS) ================= -->
<div class="modal-overlay" id="playerRoomModal">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('playerRoomModal')">✕</button>
    <div class="modal-title" id="roomModalTitle">🔑 Custom Room Access</div>
    <div class="modal-sub" id="roomModalSub">कन्फर्म खिलाड़ी: मैच शुरू होने से 15 मिनट पहले यहाँ आईडी और पासवर्ड जारी होगा।</div>

    <div id="roomUnlockedBox" style="background:#0d0f17; padding:14px; border-radius:12px; margin-bottom:16px; border:1px solid #23283a;">
      <div style="font-size: 11px; color: var(--text-muted); margin-bottom:4px;">Room ID:</div>
      <div style="font-size: 20px; font-weight: 800; color: var(--accent);" id="displayRoomId">15 मिनट पहले जारी होगा</div>
      <div style="font-size: 11px; color: var(--text-muted); margin-top: 12px; margin-bottom:4px;">Password:</div>
      <div style="font-size: 20px; font-weight: 800; color: var(--accent);" id="displayRoomPass">******</div>
    </div>

    <button class="action-btn btn-room" style="width: 100%;" onclick="closeModal('playerRoomModal')">
      बंद करें
    </button>
  </div>
</div>


<!-- ================= TOURNAMENT RANKING / RESULTS (सभी खिलाड़ी देख सकते हैं) ================= -->
<div class="modal-overlay" id="tourneyRankModal" role="dialog" aria-modal="true">
  <div class="modal-box" style="max-width:480px">
    <button class="modal-close" onclick="closeModal('tourneyRankModal')">✕</button>
    <div class="modal-title" style="color:#ffcc33">🏅 टूर्नामेंट रैंकिंग व रिज़ल्ट</div>
    <div class="tr-tabs"><button type="button" id="trTabRank" class="on" onclick="trPubTab('rank')">🏆 रैंकिंग</button><button type="button" id="trTabRes" onclick="trPubTab('res')">📋 मैच रिज़ल्ट</button></div>
    <div id="trPubRank">
      <div class="tr-chips" id="trSortChips"><button type="button" data-s="e" class="on" onclick="trSort('e')">💰 कमाई</button><button type="button" data-s="k" onclick="trSort('k')">🎯 Kills</button><button type="button" data-s="w" onclick="trSort('w')">👑 जीत</button></div>
      <div id="trRankStatus" class="tr-status">लोड हो रहा है…</div>
      <div id="trRankList" class="tr-list"></div>
    </div>
    <div id="trPubRes" style="display:none"><div id="trResStatus" class="tr-status"></div><div id="trResList" class="tr-list"></div></div>
    <button class="action-btn btn-room" style="width:100%;margin-top:14px" onclick="closeModal('tourneyRankModal')">बंद करें</button>
  </div>
</div>

<!-- ================= 2. ADVANCED ADMIN CONTROL PANEL ================= -->
<div class="modal-overlay" id="adminControlModal">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('adminControlModal')">✕</button>
    <div class="modal-title">👑 एडमिन लाइव क्लाउड कंट्रोलर</div>
    <div class="modal-sub">यहाँ से आप जो भी टाइम या स्लॉट बदलेंगे, वह <b>Firebase क्लाउड में सेव होगा और हर खिलाड़ी के मोबाइल में तुरंत बदलेगा</b>:</div>

    <div id="adminHomeBannerPanel" style="display:none;margin:12px 0;padding:12px;border:1px solid #8b5cf6;border-radius:14px;background:linear-gradient(130deg,#21153a,#111b30)">
      <b>🖼️ होम स्क्रीन के सबसे नीचे बैनर (केवल एडमिन)</b>
      <p style="font-size:12px;color:#cbd5e1;margin-top:5px">फोटो चुनें, टूर्नामेंट का टाइम और इनाम लिखें, फिर "बैनर लगाएँ" दबाएँ। आप जितने चाहें बैनर लगा सकते हैं और हर बैनर अलग से हटा सकते हैं।</p>
      <input id="adminBannerImageFile" type="file" accept="image/*">
      <input id="adminBannerCaption" type="text" maxlength="80" placeholder="बैनर का शीर्षक (जैसे: Sunday Mega Tournament)">
      <input id="adminBannerTime" type="text" maxlength="60" placeholder="टूर्नामेंट का समय (जैसे: आज रात 9:00 बजे)">
      <input id="adminBannerPrize" type="text" maxlength="120" placeholder="इनाम (जैसे: 1st ₹500 · 2nd ₹300 · 3rd ₹100)">
      <input id="adminCldPreset" type="text" maxlength="60" placeholder="Cloudinary Preset नाम (जैसे: banner_unsigned)" onchange="try{localStorage.setItem('cld_preset',this.value.trim())}catch(e){}">
      <button type="button" onclick="uploadAdminHomeBanner()">⬆️ बैनर लगाएँ</button>
      <div style="margin-top:12px;font-weight:800;font-size:13px;color:#e2e8f0">📌 लगे हुए बैनर:</div>
      <div id="adminBannerList"></div>
      <button type="button" class="banner-delete" onclick="deleteAdminHomeBanner()">🗑️ सभी बैनर हटाएँ</button>
      <div id="adminBannerStatus" style="font-size:12px;color:#cbd5e1;margin-top:6px"></div>
    </div>

    <div class="input-group">
      <label class="input-label">मैच चुनें:</label>
      <select id="adminMatchSelect" class="auth-input" onchange="loadAdminInputs()">
        <option value="br1">Bermuda Mega BR #01 (48 Slots)</option>
        <option value="br2">Purgatory Hunter #02 (48 Slots)</option>
        <option value="br3">Kalahari Solo #03 (48 Slots)</option>
        <option value="br4">Alpine Solo #04 (48 Slots)</option>
        <option value="cs1">CS 4v4 Bermuda #01 (8 Slots)</option>
        <option value="cs2">CS 4v4 Kalahari #02 (8 Slots)</option>
        <option value="cs3">CS 4v4 Purgatory #03 (8 Slots)</option>
        <option value="lw1">Lone Wolf Battle #01 (2 Slots)</option>
        <option value="lw2">Lone Wolf Showdown #02 (2 Slots)</option>
        <option value="br5">BR Victory Arena #05 (48 Slots)</option>
        <option value="br6">BR Champions Battle #06 (48 Slots)</option>
        <option value="lw3">Lone Wolf 1v1 Cartoon Showdown #03 (2 Slots)</option>
        <option value="cs4">CS Ranker Championship #04 (8 Slots)</option>
      </select>
    </div>

    <!-- DYNAMIC PRICE & REWARD CONTROLS (SET ENTRY & WINNER AMOUNT) -->
    <div style="background: rgba(255, 94, 0, 0.08); border: 1px solid var(--primary); border-radius: 12px; padding: 12px; margin-bottom: 14px;">
      <div style="font-size: 12px; font-weight: 800; color: var(--accent); margin-bottom: 8px;">💵 मैच फीस व इनाम सेटिंग (अपनी मर्जी से सेट करें):</div>
      
      <div class="input-group">
        <label class="input-label">🎮 मैच एंट्री फीस (खिलाड़ी से कितने ₹ लेने हैं):</label>
        <input type="number" id="adminInputEntry" class="auth-input" placeholder="उदा. 5 या 10">
      </div>

      <div class="input-group">
        <label class="input-label">🏆 Booyah / विजेता इनाम (जीतने वाले को कितने ₹ देने हैं):</label>
        <input type="number" id="adminInputBooyah" class="auth-input" placeholder="उदा. 200">
      </div>

      <div class="input-group">
        <label class="input-label">💀 प्रति किल इनाम (Per Kill कितने ₹ देने हैं):</label>
        <input type="number" id="adminInputPerKill" class="auth-input" placeholder="उदा. 10 (CS/Lone Wolf में 0 रखें)">
      </div>
    </div>

    <!-- ADMIN TIME CHANGER -->
    <div class="input-group">
      <label class="input-label">⏰ मैच शुरू होने का समय (जब चाहें घटाएँ/बढ़ाएँ):</label>
      <input type="text" id="adminInputTime" class="auth-input" placeholder="उदा. Today 11:00 PM या 11:30 PM">
    </div>

    <!-- ADMIN SLOTS / BANDA COUNT CHANGER -->
    <div class="input-group">
      <label class="input-label">👥 कितने बंदे आ गए हैं (Joined Slots):</label>
      <input type="number" id="adminInputSlots" class="auth-input" placeholder="उदा. 15 (ताकि 15/48 दिखे)">
    </div>

    <div class="input-group">
      <label class="input-label">🔑 कस्टम रूम आईडी (Room ID):</label>
      <input type="text" id="adminInputRoomId" class="auth-input" placeholder="उदा. 9845321">
    </div>

    <div class="input-group">
      <label class="input-label">🔒 रूम पासवर्ड (Password):</label>
      <input type="text" id="adminInputPass" class="auth-input" placeholder="उदा. 123">
    </div>

    <div style="display:none;background: rgba(255, 94, 0, 0.1); border: 1px dashed var(--primary); border-radius: 12px; padding: 12px; margin-bottom: 12px;">
      <div style="font-size: 11px; color: var(--accent); font-weight: 700; margin-bottom: 6px;">🔄 एक मैच के बाद अगला नया मैच शुरू करें:</div>
      <div style="font-size: 11px; color: #cbd5e1; line-height: 1.5; margin-bottom: 10px;">
        जब एक मैच खत्म हो जाए, तो नीचे दिए गए लाल बटन पर क्लिक करें। इससे पुराने सभी बंदों के लिए रूम तुरंत बंद (लॉक) हो जाएगा, 48 स्लॉट खाली (0/48) हो जाएँगे और नए मैच में खेलने के लिए बंदों को <b>दोबारा पैसे देने पड़ेंगे</b>!
      </div>
      <button class="action-btn" style="width: 100%; background: linear-gradient(135deg, #d32f2f 0%, #b71c1c 100%); color: #fff; padding: 12px; border-radius: 10px; font-weight: 800; cursor: pointer;" onclick="adminStartNewRoundForMatch()">
        🔴 नया मैच शुरू करें (पुराने बंदों का रूम लॉक करें व दोबारा फीस लें)
      </button>
    </div>

    <button class="action-btn btn-pay" style="width: 100%; margin-bottom: 12px;" onclick="saveMatchSettingsByAdmin()">
      ☁️ टाइम व सेटिंग्स सेव करें (Firebase लाइव)
    </button>

    <!-- ADMIN CONFIRM WALLET TOP-UP -->
    <div style="border-top: 1px dashed #2f3854; padding-top: 14px; margin-top: 14px;">
      <div style="font-size: 13px; font-weight: 700; color: var(--accent); margin-bottom: 4px;">💰 खिलाड़ी वॉलेट टॉप-अप (कन्फर्मेशन):</div>
      <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 8px;">
        खिलाड़ी ने जो PhonePe पर ₹100 या ₹50 अपनी आईडी में डालने के लिए भेजा है, उसे यहाँ से उसके खाते में जोड़ें:
      </div>
      <div class="input-group">
        <label class="input-label">खिलाड़ी का Free Fire UID:</label>
        <input type="text" id="adminTopupUid" class="auth-input" placeholder="खिलाड़ी का UID नंबर">
      </div>
      <div class="input-group">
        <label class="input-label">जोड़ने वाली रकम (₹):</label>
        <input type="number" id="adminTopupAmount" class="auth-input" placeholder="उदा. 100">
      </div>
      <button class="action-btn w-btn-add" style="width: 100%;" onclick="adminDirectAddMoney()">
        ✅ खिलाड़ी के वॉलेट में बैलेंस क्रेडिट करें
      </button>
    </div>
  <


    <!-- ADMIN MESSAGE MANAGEMENT -->
    <div style="border-top:1px dashed #2f3854; padding-top:14px; margin-top:14px;">
      <div style="font-size:13px;font-weight:700;color:#00e676;margin-bottom:4px;">📢 My Messages</div>
      <div style="font-size:11px;color:var(--text-muted);margin-bottom:10px;">
        खिलाड़ी मैसेज केवल देख सकते हैं। डिलीट बटन केवल Admin के लिए है।
      </div>
      <div id="adminMessagesList" style="max-height:260px;overflow-y:auto;display:flex;flex-direction:column;gap:8px;">
        <div style="font-size:12px;color:var(--text-muted);text-align:center;background:#0d0f17;padding:10px;border-radius:8px;">
          मैसेज लोड हो रहे हैं...
        </div>
      </div>
    </div>

    <!-- ADMIN PENDING DEPOSIT REVIEW -->
    <div style="border-top: 1px dashed #2f3854; padding-top: 14px; margin-top: 14px;">
      <div style="font-size: 13px; font-weight: 700; color: #00e676; margin-bottom: 4px;">🔔 पेंडिंग डिपॉजिट / UTR रिक्वेस्ट:</div>
      <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 10px;">
        UTR डालने से खिलाड़ी का बैलेंस अपने-आप नहीं बढ़ेगा। पहले वास्तविक पेमेंट चेक करें, फिर नीचे से मैन्युअली क्रेडिट करें।
      </div>
      <div id="adminDepositRequestsList" style="max-height: 260px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px;">
        <div style="font-size: 12px; color: var(--text-muted); text-align: center; background: #0d0f17; padding: 10px; border-radius: 8px;">
          कोई पेंडिंग डिपॉजिट नहीं है।
        </div>
      </div>
    </div>

    <!-- ADMIN WITHDRAW REQUESTS MANAGER (DIRECT PHONEPE APPROVAL) -->
    <div style="border-top: 1px dashed #2f3854; padding-top: 14px; margin-top: 14px;">
      <div style="font-size: 13px; font-weight: 700; color: #ffb703; margin-bottom: 4px;">💸 खिलाड़ी विड्रॉ रिक्वेस्ट (सीधे PhonePe से भुगतान करें):</div>
      <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 10px;">
        खिलाड़ियों द्वारा माँगे गए निकासी (विड्रॉ) अनुरोध यहाँ लाइव दिखेंगे। एक क्लिक में PhonePe खोलकर पैसे भेजें:
      </div>
      
      <div id="adminWithdrawRequestsList" style="max-height: 220px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; margin-bottom: 8px;">
        <div style="font-size: 12px; color: var(--text-muted); text-align: center; background: #0d0f17; padding: 10px; border-radius: 8px;">
          कोई नया विड्रॉ अनुरोध पेंडिंग नहीं है।
        </div>
      </div>
    </div>

    <div id="adminResetPwdBox" style="border-top:1px dashed #2f3854;padding-top:14px;margin-top:14px;">
      <div style="font-size:13px;font-weight:700;color:#38bdf8;margin-bottom:4px;">🔓 खिलाड़ी का पासवर्ड रीसेट (जब रिकवरी कोड भी भूल जाए):</div>
      <div style="font-size:11px;color:var(--text-muted);margin-bottom:8px;">रीसेट के बाद खिलाड़ी लॉगिन दबाएगा तो Gmail व गेम नाम मिलाकर नया पासवर्ड बना सकेगा।</div>
      <input type="text" id="adminResetPwdUid" class="auth-input" placeholder="खिलाड़ी का UID" inputmode="numeric">
      <button type="button" class="action-btn" style="width:100%;margin-top:8px" onclick="adminResetPlayerPassword()">🔓 पासवर्ड रीसेट करें</button>
    </div>
    <!-- ADMIN PERMANENT USER BLOCK / BAN SECTION -->
    <div style="border-top: 1px dashed #2f3854; padding-top: 14px; margin-top: 14px;">
      <div style="font-size: 13px; font-weight: 700; color: #ff4d4d; margin-bottom: 4px;">🚫 पैनल / हैक यूज़र्स को ब्लॉक (Ban) करें:</div>
      <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 8px;">
        अगर कोई बंदा गेम में पैनल/हैक लगाकर आया है, तो उसका Free Fire UID डालकर हमेशा के लिए ब्लॉक कर दें। ब्लॉक होने के बाद वह कभी लॉगिन नहीं कर पाएगा:
      </div>
      <div class="input-group">
        <label class="input-label">ब्लॉक करने वाले खिलाड़ी का Free Fire UID:</label>
        <input type="text" id="adminBanUid" class="auth-input" placeholder="उदा. 2894178392">
      </div>
      <div style="display: flex; gap: 8px;">
        <button class="action-btn" style="background: linear-gradient(135deg, #d32f2f 0%, #b71c1c 100%); color: #fff; font-weight: 800;" onclick="adminToggleUserBan(true)">
          🔴 हमेशा के लिए ब्लॉक करें
        </button>
        <button class="action-btn btn-room" style="font-size: 11px;" onclick="adminToggleUserBan(false)">
          🟢 अनब्लॉक करें
        </button>
      </div>
    </div>
  </div>
</div>


</div>
<!-- ================= WITHDRAW SUCCESS GREEN POPUP ================= -->
<div class="modal-overlay" id="withdrawSuccessModal">
  <div class="modal-box" style="text-align: center; border: 1px solid var(--success); box-shadow: 0 10px 30px rgba(0, 230, 118, 0.25);">

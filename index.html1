      <button type="button" id="confirmWithdrawBlueBtn" onclick="confirmWithdrawRequest()" style="flex:1 1 150px;border:1px solid #4ade80;border-radius:13px;padding:14px 10px;background:linear-gradient(135deg,#22c55e,#059669);color:#052e16;font-weight:900;font-size:14px;box-shadow:0 5px 18px rgba(34,197,94,.30);">✓ हाँ, कन्फर्म करें</button>

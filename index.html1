<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Free Fire Esports Arena - Firebase Cloud</title>
  <link href="https://fonts.googleapis.com/css2?family=Teko:wght@600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Firebase App & Realtime Database SDKs -->
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-database.js"></script>
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-auth.js"></script>
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-storage.js"></script>

  <style>
    :root {
      --primary: #ff5e00;
      --primary-glow: rgba(255, 94, 0, 0.4);
      --accent: #ffb703;
      --bg-dark: #0a0b10;
      --card-bg: #141724;
      --card-border: #222738;
      --text-main: #ffffff;
      --text-muted: #8e95aa;
      --success: #00e676;
      --danger: #ff4d4d;
      --purple: #8b5cf6;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      justify-content: center;
    }

    .app-container {
      width: 100%;
      max-width: 480px;
      min-height: 100vh;
      background: #0d0f17;
      position: relative;
      box-shadow: 0 0 40px rgba(0,0,0,0.8);
      overflow-x: hidden;
      padding-bottom: 90px;
    }

    /* Cloud Sync Status Indicator */
    .cloud-status-bar {
      background: #08090f;
      border-bottom: 1px solid #1a1e2e;
      padding: 4px 14px;
      font-size: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--text-muted);
    }
    .status-dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--success);
      margin-right: 5px;
      box-shadow: 0 0 6px var(--success);
    }

    /* ================= LOGIN SCREEN ================= */
    #authScreen {
      display: none; /* hidden until session restoration confirms no saved login */
      min-height: 100vh;
      padding: 24px 20px;
      flex-direction: column;
      justify-content: center;
      background: radial-gradient(circle at top, #1f142b 0%, #0d0f17 75%);
    }

    .auth-badge {
      text-align: center;
      margin-bottom: 20px;
    }

    .auth-badge h1 {
      font-family: 'Teko', sans-serif;
      font-size: 44px;
      letter-spacing: 2px;
      color: #fff;
      line-height: 1;
    }

    .auth-badge span { color: var(--primary); }
    .auth-badge p { font-size: 13px; color: var(--text-muted); margin-top: 4px; }

    .auth-card {
      background: #141724;
      border: 1px solid var(--card-border);
      border-radius: 20px;
      padding: 22px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .auth-title { font-size: 18px; font-weight: 800; margin-bottom: 4px; text-align: center; }
    
    .uid-warning {
      background: rgba(255, 183, 3, 0.1);
      border: 1px dashed var(--accent);
      border-radius: 10px;
      padding: 10px;
      font-size: 11px;
      color: #ffcc66;
      line-height: 1.4;
      margin-bottom: 16px;
      text-align: center;
    }

    .input-group { margin-bottom: 12px; }
    .input-label { font-size: 11px; font-weight: 600; color: var(--text-muted); margin-bottom: 5px; display: block; }

    .auth-input {
      width: 100%;
      background: #0d0f17;
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 12px;
      color: #fff;
      font-size: 14px;
      outline: none;
    }
    .auth-input:focus { border-color: var(--primary); }

    .btn-submit {
      width: 100%;
      background: linear-gradient(135deg, #ff5e00 0%, #e65100 100%);
      color: #fff;
      border: none;
      padding: 13px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
      margin-top: 6px;
      box-shadow: 0 4px 15px var(--primary-glow);
    }

    /* ================= MAIN SCREEN ================= */
    #mainApp { display: none; }

    .user-profile-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 18px;
      background: #111420;
      border-bottom: 1px solid var(--card-border);
    }

    .user-info { display: flex; align-items: center; gap: 10px; }
    .user-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: linear-gradient(135deg, #ff5e00, #ffb703);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 15px;
      color: #fff;
    }

    .user-name-box b { font-size: 13px; display: block; color: #fff; }
    .user-name-box span { font-size: 10px; color: var(--accent); font-family: monospace; font-weight: 600; }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn-admin-panel {
      background: rgba(255, 183, 3, 0.15);
      border: 1px solid var(--accent);
      color: var(--accent);
      padding: 6px 10px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-logout {
      background: rgba(255, 68, 68, 0.15);
      border: 1px solid #ff4444;
      color: #ff6b6b;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
    }

    /* WALLET CARD */
    .wallet-card {
      margin: 16px 18px;
      background: linear-gradient(135deg, #181d2f 0%, #0f121d 100%);
      border: 1px solid #2f3854;
      border-radius: 20px;
      padding: 18px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.45);
    }

    .wallet-top-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 16px;
    }

    .wallet-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .wallet-balance {
      font-family: 'Teko', sans-serif;
      font-size: 42px;
      font-weight: 700;
      color: var(--success);
      line-height: 1;
    }

    .wallet-subtext {
      font-size: 10px;
      color: #8e95aa;
      margin-top: 2px;
    }

    .wallet-grid-4 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .w-btn {
      padding: 12px 10px;
      border-radius: 12px;
      border: none;
      font-size: 12px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
    }

    .w-btn-add {
      background: linear-gradient(135deg, #00c853 0%, #009624 100%);
      color: #fff;
      box-shadow: 0 4px 12px rgba(0, 200, 83, 0.25);
    }

    .w-btn-withdraw {
      background: linear-gradient(135deg, #e53935 0%, #b71c1c 100%);
      color: #fff;
      box-shadow: 0 4px 12px rgba(229, 57, 53, 0.25);
    }

    .w-btn-history {
      background: #1c2236;
      border: 1px solid var(--card-border);
      color: #d1d5db;
    }

    .w-btn-adminpay {
      background: linear-gradient(135deg, #ff5e00 0%, #e65100 100%);
      color: #fff;
      box-shadow: 0 4px 12px var(--primary-glow);
    }

    /* Category Tabs */
    .filter-tabs {
      display: flex;
      gap: 8px;
      padding: 0 18px;
      margin: 18px 0 14px;
      overflow-x: auto;
    }

    .tab-btn {
      background: #151824;
      border: 1px solid var(--card-border);
      color: var(--text-muted);
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
    }
    .tab-btn.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff;
    }

    .section-header {
      padding: 0 18px;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .section-title { font-size: 16px; font-weight: 800; }

    .tournament-cover {display:block;width:100%;height:auto;max-height:250px;object-fit:cover;border-bottom:1px solid #29324b;}
    .youtube-promo {margin:18px;padding:0;background:#141724;border:1px solid #ff5e00;border-radius:16px;overflow:hidden;}
    .youtube-promo a {display:block;color:#fff;text-decoration:none;}
    .youtube-promo img {display:block;width:100%;height:auto;}
    .youtube-promo .yt-caption {padding:12px;text-align:center;font-weight:800;color:#ffcc33;}
    /* Match Cards */
    .cards-container {
      padding: 0 18px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .match-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }

    .card-top {
      padding: 12px 16px;
      background: #181c2c;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .match-tag {
      font-size: 11px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 6px;
      background: rgba(255,255,255,0.08);
      color: #d1d5db;
    }

    .match-tag.cs {
      background: rgba(139, 92, 246, 0.2);
      border: 1px solid var(--purple);
      color: #c4b5fd;
    }

    .match-tag.lw {
      background: rgba(255, 183, 3, 0.2);
      border: 1px solid var(--accent);
      color: #ffcc66;
    }

    .status-badge {
      background: rgba(0, 230, 118, 0.15);
      border: 1px solid var(--success);
      color: var(--success);
      font-size: 11px;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 12px;
    }

    .card-body { padding: 16px; }

    .match-name {
      font-size: 17px;
      font-weight: 800;
      margin-bottom: 4px;
      color: #fff;
    }

    .match-schedule {
      font-size: 12px;
      color: var(--accent);
      font-weight: 600;
      margin-bottom: 14px;
    }

    .reward-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      background: #0f121d;
      padding: 12px;
      border-radius: 12px;
      margin-bottom: 14px;
    }

    .reward-box { text-align: center; }
    .reward-label { font-size: 10px; color: var(--text-muted); text-transform: uppercase; font-weight: 600; margin-bottom: 2px; }
    .reward-val { font-size: 15px; font-weight: 800; color: #fff; }
    .reward-val.highlight { color: var(--accent); }
    .reward-val.entry { color: var(--primary); }

    .upi-info-box {
      background: rgba(255, 94, 0, 0.08);
      border: 1px dashed var(--primary);
      border-radius: 12px;
      padding: 12px;
      margin-bottom: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .upi-left { font-size: 11px; }
    .upi-label { color: var(--text-muted); margin-bottom: 2px; }
    .upi-id { font-family: monospace; font-size: 13px; font-weight: 700; color: #fff; }

    .copy-btn {
      background: var(--primary);
      color: #fff;
      border: none;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
    }

    .card-footer { display: flex; gap: 10px; }

    .action-btn {
      flex: 1;
      padding: 12px;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 700;
      text-align: center;
      text-decoration: none;
      display: inline-block;
      cursor: pointer;
      border: none;
    }

    .btn-pay {
      background: linear-gradient(135deg, #ff5e00 0%, #e65100 100%);
      color: #fff;
      box-shadow: 0 4px 15px var(--primary-glow);
    }

    .btn-room {
      background: #1c2032;
      color: #d1d5db;
      border: 1px solid var(--card-border);
    }

    /* Modal */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.85);
      z-index: 10100;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-box {
      background: #141724;
      border: 1px solid #2a3148;
      border-radius: 20px;
      max-width: 420px;
      width: 100%;
      padding: 24px;
      position: relative;
      max-height: 90vh;
      overflow-y: auto;
    }

    .modal-title { font-size: 18px; font-weight: 800; margin-bottom: 8px; }
    .modal-sub { font-size: 12px; color: var(--text-muted); margin-bottom: 18px; line-height: 1.5; }

    .modal-close {
      position: absolute;
      top: 18px;
      right: 18px;
      background: #202638;
      border: none;
      color: #fff;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      cursor: pointer;
    }

    /* Bottom Navigation */
    .bottom-bar {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 480px;
      background: rgba(13, 15, 23, 0.95);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--card-border);
      display: flex;
      justify-content: space-around;
      padding: 10px 0;
      z-index: 50;
    }

    .nav-item {
      text-align: center;
      color: var(--text-muted);
      font-size: 10px;
      font-weight: 600;
      cursor: pointer;
    }

    .nav-item.active { color: var(--primary); }
    .nav-icon { font-size: 18px; margin-bottom: 2px; }
  
    /* Top Push Notification Banner (Like YouTube/Android System Banner) */
    .top-notification-banner {
      position: fixed;
      top: -120px;
      left: 50%;
      transform: translateX(-50%);
      width: 92%;
      max-width: 440px;
      background: linear-gradient(135deg, #1b2133 0%, #111422 100%);
      border: 1px solid var(--accent);
      border-left: 5px solid var(--success);
      border-radius: 16px;
      padding: 14px 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.85);
      z-index: 9999;
      display: flex;
      align-items: center;
      gap: 12px;
      transition: top 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .top-notification-banner.show {
      top: 16px;
    }
    /* Colorful, rounded notification styles; message text stays unchanged. */
    .top-notification-banner.notif-deposit {
      background: linear-gradient(135deg, #3b210b 0%, #171421 88%);
      border-color: #fb923c; border-left-color: #f97316;
      box-shadow: 0 10px 30px rgba(0,0,0,.75), 0 0 22px rgba(249,115,22,.22);
    }
    .top-notification-banner.notif-withdraw {
      background: linear-gradient(135deg, #3a111b 0%, #171421 88%);
      border-color: #fb7185; border-left-color: #ef4444;
      box-shadow: 0 10px 30px rgba(0,0,0,.75), 0 0 22px rgba(239,68,68,.2);
    }
    .top-notification-banner.notif-match {
      background: linear-gradient(135deg, #073b2b 0%, #111827 88%);
      border-color: #34d399; border-left-color: #00e676;
      box-shadow: 0 10px 30px rgba(0,0,0,.75), 0 0 22px rgba(0,230,118,.22);
    }
    .top-notification-banner.notif-admin {
      background: linear-gradient(135deg, #302407 0%, #171421 88%);
      border-color: #facc15; border-left-color: #fbbf24;
      box-shadow: 0 10px 30px rgba(0,0,0,.75), 0 0 22px rgba(250,204,21,.2);
    }
    .top-notification-banner.notif-deposit .notif-bell { background: rgba(249,115,22,.22); }
    .top-notification-banner.notif-withdraw .notif-bell { background: rgba(239,68,68,.22); }
    .top-notification-banner.notif-match .notif-bell { background: rgba(0,230,118,.18); }
    .top-notification-banner.notif-admin .notif-bell { background: rgba(250,204,21,.2); }
    .notif-bell {
      width: 42px;
      height: 42px;
      background: rgba(255, 183, 3, 0.15);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
      animation: bellRing 1.5s infinite;
    }
    @keyframes bellRing {
      0%, 100% { transform: rotate(0); }
      20%, 60% { transform: rotate(15deg); }
      40%, 80% { transform: rotate(-15deg); }
    }

  
/* Offline / internet recovery dialog: additive feature */
#internetOfflineOverlay{display:none;position:fixed;inset:0;z-index:20000;background:rgba(2,6,16,.88);backdrop-filter:blur(9px);align-items:center;justify-content:center;padding:20px}
#internetOfflineOverlay .internet-card{width:min(100%,390px);border:1px solid #3b4968;border-radius:24px;padding:26px 22px;background:linear-gradient(145deg,#17233b,#101421 65%,#251638);box-shadow:0 18px 70px #000b,0 0 28px #ff5e0020;text-align:center;color:#fff}
#internetOfflineOverlay .internet-icon{width:76px;height:76px;border-radius:24px;margin:0 auto 15px;display:grid;place-items:center;font-size:36px;background:linear-gradient(135deg,#ff5e00,#ffb703);box-shadow:0 8px 24px #ff5e0040}
#internetOfflineOverlay h2{font-size:24px;margin:8px 0;color:#fff}
#internetOfflineOverlay p{font-size:14px;line-height:1.65;color:#aeb8cc;margin:10px 0 20px}
#internetOfflineOverlay .internet-action{display:block;width:100%;border:0;border-radius:13px;padding:14px 12px;margin-top:10px;font-weight:800;font-size:15px;color:#fff;background:linear-gradient(100deg,#ff5e00,#ff8a00)}
#internetOfflineOverlay .internet-secondary{background:#202b43;border:1px solid #3b4968}
#internetOfflineOverlay .internet-status{font-size:12px;color:#ffcf70;margin-top:13px}

</style>

<style id="pending-delete-confirm-style">
  #pendingDeleteConfirmOverlay{
    position:fixed;inset:0;background:rgba(0,0,0,.72);display:none;align-items:center;justify-content:center;z-index:99999;padding:18px;
  }
  #pendingDeleteConfirmBox{
    width:min(360px,100%);background:#10141f;border:1px solid #2b3956;border-radius:16px;padding:18px;box-shadow:0 18px 60px rgba(0,0,0,.5);text-align:center;
  }
  #pendingDeleteConfirmBox h3{margin:0 0 8px;color:#fff;font-size:18px;}
  #pendingDeleteConfirmBox p{margin:0 0 16px;color:#b9c2d3;font-size:13px;line-height:1.5;}
  #pendingDeleteConfirmBox .pdc-actions{display:flex;gap:10px;}
  #pendingDeleteConfirmBox button{flex:1;border:0;border-radius:10px;padding:12px 10px;font-weight:800;font-size:13px;}
  #pendingDeleteCancel{background:#252d3d;color:#fff;}
  #pendingDeleteYes{background:#22c55e;color:#07130a;}
  #pendingDeleteYes:disabled{opacity:.55;}
</style>


<style id="requested-payment-layout-fixes">
/* Keep UPI ID and Copy button aligned inside every payment box */
.upi-info-box{
  display:flex; align-items:center; gap:10px; min-width:0;
  width:100%; overflow:hidden; padding:12px; border-radius:14px;
}
.upi-left{flex:1 1 auto; min-width:0; overflow:hidden;}
.upi-id{
  display:block; width:100%; min-width:0; overflow-wrap:anywhere;
  word-break:break-word; line-height:1.35; font-size:clamp(11px,3.1vw,14px);
}
.copy-btn{flex:0 0 auto; min-width:68px; white-space:nowrap; padding:9px 12px;}
.qr-container{overflow:hidden!important; width:100%; }
.qr-container img{
  display:block!important; width:min(100%,390px)!important; max-width:100%!important;
  height:auto!important; max-height:470px; object-fit:contain!important;
  margin:8px auto!important; background:#fff; border-radius:18px;
}
.qr-container .upi-id{font-size:clamp(11px,3.2vw,14px); overflow-wrap:anywhere;}
@media(max-width:380px){
 .upi-info-box{padding:9px;gap:7px}
 .copy-btn{min-width:60px;padding:8px 9px}
 .qr-container{padding:10px!important}
}
/* Styled replacement for the specific amount-lock notice */
#depositLockNotice{position:fixed;inset:0;z-index:100000;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(0,0,0,.78);backdrop-filter:blur(5px)}
#depositLockNotice .notice-card{width:min(380px,100%);border:1px solid #22c55e;border-radius:24px;padding:24px 20px;background:linear-gradient(145deg,#102c20,#111a20 72%);box-shadow:0 18px 55px rgba(0,0,0,.65),0 0 25px rgba(34,197,94,.18);text-align:center}
#depositLockNotice .notice-icon{width:62px;height:62px;margin:0 auto 14px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#4ade80,#16a34a);font-size:30px;color:#06230f;box-shadow:0 6px 18px rgba(34,197,94,.25)}
#depositLockNotice h3{font-size:19px;color:#86efac;margin:0 0 10px}
#depositLockNotice p{font-size:14px;line-height:1.65;color:#e5e7eb;margin:0 0 20px}
#depositLockNotice button{width:100%;border:0;border-radius:14px;padding:13px;background:linear-gradient(135deg,#4ade80,#16a34a);color:#052e16;font-weight:800;font-size:15px}
</style>


<style id="utr-confirm-success-style">
  .utr-flow-overlay{
    display:none;position:fixed;inset:0;z-index:100001;
    background:rgba(0,0,0,.82);backdrop-filter:blur(6px);
    align-items:center;justify-content:center;padding:18px;
  }
  .utr-flow-card{
    width:min(390px,100%);max-height:88vh;overflow-y:auto;
    background:linear-gradient(145deg,#141b2b 0%,#0e1420 100%);
    border:1px solid #2f3b59;border-radius:24px;padding:22px 18px;
    box-shadow:0 22px 70px rgba(0,0,0,.72),0 0 28px rgba(255,183,3,.12);
    text-align:center;
  }
  .utr-flow-icon{
    width:64px;height:64px;border-radius:50%;margin:0 auto 12px;
    display:grid;place-items:center;font-size:31px;
    background:linear-gradient(145deg,#facc15,#f59e0b);color:#241600;
    box-shadow:0 7px 22px rgba(250,204,21,.24);
  }
  .utr-flow-card.success .utr-flow-icon{
    background:linear-gradient(145deg,#4ade80,#16a34a);color:#052e16;
    box-shadow:0 7px 22px rgba(34,197,94,.24);
  }
  .utr-flow-title{font-size:20px;font-weight:900;color:#fff;margin-bottom:7px;}
  .utr-flow-sub{font-size:13px;line-height:1.6;color:#b9c2d3;margin-bottom:15px;}
  .utr-summary{
    background:#0a0f18;border:1px solid #27324a;border-radius:14px;
    padding:12px;text-align:left;margin:12px 0 16px;
  }
  .utr-summary-row{
    display:flex;justify-content:space-between;gap:10px;
    font-size:12px;padding:5px 0;color:#aab3c5;
  }
  .utr-summary-row b{color:#fff;text-align:right;overflow-wrap:anywhere;}
  .utr-confirm-btn,.utr-success-btn{
    width:100%;border:0;border-radius:14px;padding:13px 12px;
    font-size:14px;font-weight:900;cursor:pointer;
  }
  .utr-confirm-btn{background:linear-gradient(135deg,#facc15,#f59e0b);color:#241600;}
  .utr-success-btn{background:linear-gradient(135deg,#4ade80,#16a34a);color:#052e16;}
  .utr-cancel-btn{
    width:100%;margin-top:9px;border:1px solid #303b55;border-radius:14px;
    padding:12px;background:#20283a;color:#fff;font-weight:800;cursor:pointer;
  }
  .utr-success-note{
    background:#092318;border:1px solid #1fbf66;color:#bbf7d0;
    border-radius:13px;padding:11px;font-size:12px;line-height:1.55;
    text-align:left;margin:12px 0 15px;
  }
  .utr-checkline{
    background:#211b05;border:1px solid #806600;color:#ffe082;
    border-radius:12px;padding:10px;font-size:11px;line-height:1.5;
    text-align:left;margin:10px 0 15px;
  }
</style>


<style id="zest-safe-additions">
/* Additions only: original app styles and bottom controls remain intact */
.zest-event-slider{margin:14px 18px 18px;overflow:hidden;border-radius:16px;position:relative;background:#141724;border:1px solid #29324b}
.zest-event-track{display:flex;transition:transform .45s ease;will-change:transform}
.zest-event-card{min-width:100%;padding:16px 18px;box-sizing:border-box;text-align:center}
.zest-event-card h3{margin:0 0 5px;font-size:21px;color:#fff}
.zest-event-card p{margin:0;font-size:12px;color:#d1d5db}
.zest-event-card b{color:#ffcc33}
.zest-event-dots{display:flex;justify-content:center;gap:6px;padding:0 0 9px}
.zest-event-dot{width:6px;height:6px;border-radius:50%;background:#586174}.zest-event-dot.active{background:#ff5e00;width:18px;border-radius:8px}
.zest-profile-overlay{position:fixed;inset:0;background:rgba(0,0,0,.62);display:none;align-items:center;justify-content:center;z-index:10050;padding:16px}
.zest-profile-card{width:min(365px,calc(100vw - 32px));background:#111522;border:1px solid #30384f;border-radius:20px;box-shadow:0 18px 60px rgba(0,0,0,.55);overflow:hidden}
.zest-profile-head{padding:16px;border-bottom:1px solid #29324b;display:flex;align-items:center;justify-content:space-between}
.zest-profile-head b{font-size:18px;color:#fff}.zest-profile-close{border:0;background:#252d3d;color:#fff;border-radius:10px;width:34px;height:34px}
.zest-profile-body{padding:16px}.zest-profile-avatar{width:62px;height:62px;border-radius:50%;margin:0 auto 10px;display:grid;place-items:center;background:#ff5e00;color:#fff;font-weight:900;font-size:22px}
.zest-profile-name{text-align:center;font-weight:900;color:#fff;font-size:17px}.zest-profile-uid{text-align:center;color:#9ca3af;font-size:11px;margin:3px 0 14px}
.zest-profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.zest-profile-stat{background:#181d2c;border:1px solid #29324b;border-radius:12px;padding:11px}.zest-profile-stat span{display:block;color:#8e95aa;font-size:10px}.zest-profile-stat b{display:block;color:#fff;font-size:14px;margin-top:3px}
.zest-referral-note{color:#ff5e5e;font-size:10px;line-height:1.4;margin-top:5px}
</style>

<style id="referral-points-admin-css">
.ref-admin-box{margin-top:12px;padding:12px;border:1px solid rgba(255,255,255,.12);border-radius:12px;background:#121212}.ref-admin-box h4{margin:0 0 8px}.ref-admin-box input{width:100%;padding:9px;border-radius:8px;border:1px solid #555;background:#1d1d1d;color:#fff}.ref-admin-actions{display:flex;gap:8px;margin-top:8px}.ref-admin-actions button{flex:1;padding:9px;border:0;border-radius:8px}.ref-points-note{font-size:11px;color:#ffb703;margin-top:6px}
</style>
<style id="requested-profile-refresh">
:root{--bg-dark:#090e19;--card-bg:#171d30;--card-border:#303a56}
.app-container{background:radial-gradient(ellipse at 15% 0%,#172544 0%,#0b101c 45%,#11101e 100%)}
.user-profile-bar{padding:9px 14px;background:linear-gradient(110deg,#111b2e,#171625);gap:6px}
.user-avatar{width:34px;height:34px;flex:0 0 34px}
.user-name-box b{font-size:11px;max-width:135px;overflow-wrap:anywhere}
.user-name-box span{font-size:9px}
.top-actions{gap:5px}.btn-admin-panel,.btn-logout{padding:6px 8px;font-size:10px}
.bottom-bar .nav-item{flex:1}.bottom-bar{padding:8px 2px;background:rgba(12,16,29,.97)}
.zest-profile-overlay{backdrop-filter:blur(8px);background:rgba(2,6,16,.82)}
.zest-profile-card{background:linear-gradient(150deg,#18233b,#101421 70%,#24172b);border-color:#465579;max-height:90vh;overflow:auto;box-shadow:0 0 40px #000,0 0 24px #ff5e0020}
.zest-profile-head{position:sticky;top:0;background:#111827;z-index:2}
.zest-profile-stat{background:linear-gradient(145deg,#1d2942,#151a2a);border-color:#34415f}
.zest-profile-stat b{overflow-wrap:anywhere}
.zest-profile-back{position:sticky;top:8px;float:right;z-index:4;margin:8px 8px -42px 0;border:1px solid #64748b;border-radius:9px;background:#263247;color:white;padding:7px 10px}
.zest-profile-extra{display:flex;gap:8px;margin-top:10px}.zest-profile-extra button{flex:1;border:1px solid #3b4763;background:#202b43;color:#fff;padding:10px 5px;border-radius:10px;font-weight:800}
.zest-event-card{background:linear-gradient(130deg,#37200d,#172744 55%,#27143b);min-height:90px;display:flex;flex-direction:column;justify-content:center}
.zest-event-card:nth-child(2){background:linear-gradient(130deg,#073c35,#1c2442,#3b1b35)}
.zest-event-card:nth-child(3){background:linear-gradient(130deg,#392b06,#251b42,#123c48)}
.zest-event-card:nth-child(4){background:linear-gradient(130deg,#301044,#142c50,#073c35)}
.zest-event-card:nth-child(5){background:linear-gradient(130deg,#4a1b26,#202744,#3b2b09)}
#zestProfileLeaderboardPanel{animation:profilePanelIn .2s ease-out}
/* Top 50 opens as a full-screen layer above My Profile, not below the profile cards. */
#zestProfileLeaderboardPanel[style*="display: block"]{position:fixed!important;inset:0!important;z-index:12000!important;margin:0!important;padding:18px 14px 24px!important;border:0!important;border-radius:0!important;background:radial-gradient(ellipse at top,#1b2b4b 0%,#090d17 72%)!important;box-sizing:border-box;overflow:auto;max-height:100dvh;}
#zestProfileLeaderboardPanel[style*="display: block"] #zestProfileLeaderboardList{max-height:calc(100dvh - 180px)!important;overflow:auto}
#zestProfileLeaderboardPanel[style*="display: block"] #zestProfileLeaderboardStatus{font-size:13px!important;padding:14px!important}
#zestProfileLeaderboardPanel[style*="display: block"] button{max-width:520px;display:block;margin-left:auto;margin-right:auto}
@keyframes profilePanelIn{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:translateY(0)}}
.daily-match-note{font-size:10px;color:#93c5fd;margin-top:4px}

/* Profile actions: three clear colorful buttons, no duplicate Wallet button */
.zest-profile-wallet-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:12px 0 16px}
.zest-profile-wallet-actions button{min-height:48px;border:1px solid rgba(255,255,255,.22);border-radius:13px;color:#fff;font-weight:900;font-size:14px;padding:10px 8px;box-shadow:0 5px 14px rgba(0,0,0,.2);cursor:pointer}
.zest-profile-wallet-actions .profile-action-deposit{background:linear-gradient(120deg,#00b86b,#078ed0)}
.zest-profile-wallet-actions .profile-action-withdraw{background:linear-gradient(120deg,#ff7a18,#e91e63)}
.zest-profile-wallet-actions .profile-action-passbook{background:linear-gradient(120deg,#7c3aed,#2563eb);grid-column:1/-1}
#customHomeBannerSlot{margin:18px 18px 92px;border-radius:16px;overflow:hidden;border:1px solid #8b5cf6;box-shadow:0 0 18px #8b5cf633}
#customHomeBannerSlot img{display:block;width:100%;height:auto;max-height:360px;object-fit:contain;background:#080b12}
#customHomeBannerSlot .custom-banner-caption{padding:10px;text-align:center;background:linear-gradient(100deg,#15152b,#242044);color:#fcd34d;font-weight:900}
#adminBannerStatus{overflow-wrap:anywhere}
</style>

<style id="startup-screen-fix">
#appStartupSplash{position:fixed;inset:0;z-index:200000;background:radial-gradient(circle at 50% 25%,#202945 0%,#101522 48%,#080b12 100%);display:flex;align-items:center;justify-content:center;color:#fff;font-family:Inter,Arial,sans-serif;text-align:center;padding:24px;}
#appStartupSplash .startup-logo{width:78px;height:78px;border-radius:22px;margin:0 auto 18px;display:flex;align-items:center;justify-content:center;font-size:38px;background:linear-gradient(135deg,#ffb703,#ff5e00);box-shadow:0 0 32px rgba(255,94,0,.35)}
#appStartupSplash h2{margin:0;font-size:25px;letter-spacing:1px}#appStartupSplash p{color:#aab3c5;margin:9px 0 20px;font-size:13px}
#appStartupSplash .startup-spinner{width:28px;height:28px;border:3px solid #394158;border-top-color:#ff8a00;border-radius:50%;margin:auto;animation:startupSpin .8s linear infinite}
@keyframes startupSpin{to{transform:rotate(360deg)}}
</style>

<style id="profile-and-banner-enhancements">
.zest-profile-card{background:linear-gradient(145deg,#101b32,#17152b 58%,#24142c)!important;border:1px solid #53638c!important;box-shadow:0 0 30px #8b5cf633,0 18px 60px #000b!important}
.zest-profile-head{background:linear-gradient(100deg,#14233e,#211733)!important}
.zest-profile-identity{display:flex;align-items:center;justify-content:flex-start;gap:12px;margin:2px 0 10px}.zest-profile-identity .zest-profile-avatar{margin:0;flex:0 0 62px;background:linear-gradient(135deg,#ffb703,#ff5e00)!important;box-shadow:0 0 22px #ff5e0055}.zest-profile-identity .zest-profile-name{text-align:left;overflow-wrap:anywhere;font-size:18px}
.zest-profile-grid{gap:10px!important}
.zest-profile-stat{background:linear-gradient(135deg,#202b46,#19172d)!important;border:1px solid transparent!important;background-clip:padding-box!important;box-shadow:inset 0 0 0 1px #8b5cf655,0 4px 15px #0003}
.zest-profile-stat:nth-child(4n+1){box-shadow:inset 0 0 0 1px #fb923c99,0 4px 15px #0003}
.zest-profile-stat:nth-child(4n+2){box-shadow:inset 0 0 0 1px #22d3ee88,0 4px 15px #0003}
.zest-profile-stat:nth-child(4n+3){box-shadow:inset 0 0 0 1px #a78bfa88,0 4px 15px #0003}
.zest-profile-extra button{background:linear-gradient(120deg,#ff8a00,#e83e8c,#4355db)!important;border:1px solid #ffffff2b!important;color:#fff!important}
.zest-profile-wallet-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:12px 0}
.zest-profile-wallet-actions button{border:0;border-radius:12px;padding:12px 8px;color:white;font-weight:900;font-size:13px;background:linear-gradient(120deg,#00b85a,#087fdb);box-shadow:0 5px 15px #0004}
.zest-profile-wallet-actions button:nth-child(2){background:linear-gradient(120deg,#f97316,#e11d48)}
.zest-profile-wallet-actions button:nth-child(3){background:linear-gradient(120deg,#7c3aed,#2563eb)}
.zest-profile-wallet-actions button:nth-child(4){background:linear-gradient(120deg,#0891b2,#0d9488)}
#adminHomeBannerPanel{margin:12px 0;padding:12px;border:1px solid #8b5cf6;border-radius:14px;background:linear-gradient(130deg,#21153a,#111b30)}
#adminHomeBannerPanel input{width:100%;margin:7px 0;padding:10px;background:#0b1020;color:#fff;border:1px solid #475569;border-radius:9px}
#adminHomeBannerPanel button{border:0;border-radius:9px;padding:10px 12px;font-weight:800;color:#fff;background:linear-gradient(100deg,#7c3aed,#2563eb);margin:4px 3px 0 0}
#adminHomeBannerPanel .banner-delete{background:linear-gradient(100deg,#dc2626,#9f1239)}
#customHomeBannerSlot:empty{display:none}
#customHomeBannerSlot{margin:12px 18px;border-radius:15px;overflow:hidden;border:1px solid #8b5cf6;box-shadow:0 0 18px #8b5cf633}
#customHomeBannerSlot img{display:block;width:100%;height:auto;max-height:260px;object-fit:cover}
#customHomeBannerSlot .custom-banner-caption{padding:8px;text-align:center;background:#15152b;color:#fcd34d;font-weight:800}
</style>

</head>
<body>
<div id="appStartupSplash" aria-live="polite"><div><div class="startup-logo">🏆</div><h2>FREE FIRE BATTLE</h2><p>आपका टूर्नामेंट ऐप खुल रहा है…</p><div class="startup-spinner"></div></div></div>

<div class="app-container">
  <!-- Live Notification Dropdown Banner -->
  <div id="topNotificationBanner" class="top-notification-banner" onclick="handleNotificationBannerClick()">
    <div class="notif-bell">🔔</div>
    <div style="flex: 1;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
        <b style="font-size: 13px; color: #ffb703;" id="bannerNotifTitle">नया विड्रॉ अलर्ट!</b>
        <span style="font-size: 10px; color: var(--text-muted);" id="bannerNotifTime">अभी</span>
      </div>
      <div style="font-size: 12px; color: #fff; line-height: 1.4;" id="bannerNotifBody">किसी खिलाड़ी ने पैसे निकालने की रिक्वेस्ट भेजी है।</div>
    </div>
    <button type="button" class="notif-close" aria-label="बंद करें" onclick="event.stopPropagation();closeTopNotificationBanner()">✕</button>
  </div>


  <!-- Cloud Status Bar -->
  <div class="cloud-status-bar">
    <div><span class="status-dot" id="firebaseDot"></span><span id="firebaseStatusText">Firebase Cloud Connected</span></div>
    <div style="font-family: monospace;" id="syncTimeText">Live Sync</div>
  </div>

  <!-- ================= LOGIN SCREEN ================= -->
  <div id="authScreen">
    <div class="auth-badge">
      <h1>FREE FIRE <span>BATTLE</span></h1>
      <p>Esports टूर्नामेंट और रिजल्ट वेरिफिकेशन (Firebase Cloud)</p>
    </div>

    <div class="auth-card">
      <div class="auth-tabs">
        <button type="button" id="authTabLogin" class="on" onclick="authTab('login')">🔑 लॉगिन</button>
        <button type="button" id="authTabSignup" onclick="authTab('signup')">📝 साइन अप</button>
      </div>

      <!-- LOGIN -->
      <form id="loginPane" onsubmit="doLogin(event)">
        <div class="input-group">
          <label class="input-label">🆔 Free Fire UID या ✉️ Gmail:</label>
          <input type="text" id="loginId" class="auth-input" placeholder="UID या player@gmail.com" autocomplete="username" required>
        </div>
        <div class="input-group">
          <label class="input-label">🔒 पासवर्ड:</label>
          <div class="pw-wrap"><input type="password" id="loginPass" class="auth-input" placeholder="अपना पासवर्ड डालें" autocomplete="current-password" required><button type="button" class="pw-eye" onclick="togglePw('loginPass')">👁</button></div>
        </div>
        <button type="submit" class="btn-submit">लॉगिन करें ➔</button>
        <div class="auth-links"><a href="#" onclick="openForgot();return false;">🔓 पासवर्ड भूल गए?</a><a href="#" onclick="authTab('signup');return false;">नया खाता बनाएँ</a></div>
      </form>

      <!-- SIGN UP -->
      <form id="signupPane" style="display:none" onsubmit="doSignup(event)">
        <div class="uid-warning">⚠️ <b>ध्यान दें:</b> केवल वही नाम और UID भरें जो आपके Free Fire गेम में है। एक Gmail से एक ही UID रजिस्टर हो सकती है।</div>
        <div class="input-group">
          <label class="input-label">🎮 Free Fire इन-गेम नाम (Exact IGN):</label>
          <input type="text" id="ffName" class="auth-input" placeholder="उदा. कातिल_प्रकाश या Pro_Killer" required>
        </div>
        <div class="input-group">
          <label class="input-label">🆔 Free Fire UID (गेम प्रोफाइल नंबर):</label>
          <input type="number" id="ffUid" class="auth-input" placeholder="उदा. 2894178392" required>
        </div>
        <div class="input-group">
          <label class="input-label">✉️ ईमेल आईडी (Gmail):</label>
          <input type="email" id="userEmail" class="auth-input" placeholder="player@gmail.com" autocomplete="email" required>
        </div>
        <div class="input-group">
          <label class="input-label">🔒 पासवर्ड बनाएँ (कम से कम 6 अक्षर):</label>
          <div class="pw-wrap"><input type="password" id="suPass" class="auth-input" placeholder="नया पासवर्ड" autocomplete="new-password" required><button type="button" class="pw-eye" onclick="togglePw('suPass')">👁</button></div>
        </div>
        <div class="input-group">
          <label class="input-label">🔒 पासवर्ड दोबारा डालें:</label>
          <input type="password" id="suPass2" class="auth-input" placeholder="वही पासवर्ड फिर से" autocomplete="new-password" required>
        </div>
        <div class="input-group">
          <label class="input-label">🛡️ रिकवरी कोड (4 से 6 अंक, याद रखें):</label>
          <input type="tel" id="suRec" class="auth-input" placeholder="उदा. 4821" maxlength="6" inputmode="numeric" required>
          <div class="zest-referral-note">पासवर्ड भूलने पर यही कोड पूछा जाएगा। किसी को न बताएँ।</div>
        </div>
        <div class="input-group">
          <label class="input-label">🎁 Referral Code (Optional):</label>
          <input type="text" id="referralCode" class="auth-input" placeholder="Referral Code डालें" maxlength="20" autocomplete="off">
          <div class="zest-referral-note">Referral Code नहीं है तो इसे खाली छोड़ सकते हैं।</div>
        </div>
        <button type="submit" class="btn-submit">साइन अप करें ➔</button>
        <div class="auth-links"><a href="#" onclick="authTab('login');return false;">पहले से खाता है? लॉगिन करें</a></div>
      </form>
    </div>
  </div>

  <!-- ================= MAIN APP SCREEN ================= -->
  <div id="mainApp">
    
    <div class="user-profile-bar">
      <div class="user-info">
        <div class="user-avatar" id="avatarLetter">FF</div>
        <div class="user-name-box">
          <b id="displayPlayer">Player_IGN</b> <button type="button" aria-label="नाम और UID बदलें" title="नाम और UID बदलें" onclick="openEditIgnModal()" style="margin-left:5px;background:#252d3d;border:1px solid #ffcc33;color:#ffcc33;border-radius:50%;width:25px;height:25px;padding:0;font-size:13px;cursor:pointer;vertical-align:middle;">✏️</button>
          <span>UID: <span id="displayUid">0000000000</span></span>
        </div>
      </div>
      <div class="top-actions">
        <!-- 👑 Admin button ab My Profile me hai (sirf admin ko dikhta hai) -->
        <button class="btn-logout" onclick="startLogoutStep1()">
          🚪 Log out
        </button>
      </div>
    </div>

    <!-- 🏅 Tournament Ranking & Result card (home screen, just below profile/Log out bar) -->
    <div class="tr-hero-wrap">
      <button type="button" class="tr-hero-card" onclick="openTourneyRank()" aria-label="टूर्नामेंट रैंकिंग व रिज़ल्ट">
        <span class="tr-hero-medal">🏅</span>
        <span class="tr-hero-text"><b>टूर्नामेंट रैंकिंग व रिज़ल्ट</b><small>Kills · जीत · इनाम · सभी खिलाड़ी देख सकते हैं</small></span>
      </button>
    </div>

    <!-- WALLET CARD (OWN WALLET BALANCE) -->
    <div class="wallet-card">
      <div class="wallet-top-row">
        <div>
          <span class="wallet-label">💰 MY WALLET BALANCE</span>
